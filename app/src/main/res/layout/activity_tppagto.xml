<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="600dp"
    android:layout_height="125dp"
    android:background="@drawable/botaonum_estilo">

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/dinheiro_pix"
        android:layout_width="200dp"
        android:layout_height="75dp"
        android:background="@drawable/botao_numerico"
        android:text="DINHEIRO/PIX"
        android:textSize="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/cartao_cd"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/cartao_cd"
        android:layout_width="200dp"
        android:layout_height="75dp"
        android:background="@drawable/botao_numerico"
        android:text="CARTÃO DEBITO/CREDITO"
        android:textSize="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/dinheiro_pix"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints" />


</androidx.constraintlayout.widget.ConstraintLayout>